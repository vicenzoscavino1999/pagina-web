# Copy this file to .env.local for local development.
# .env.local is gitignored and should not be committed.

# Future tracking API base URL
# VITE_TRACKING_API_URL=https://api.example.com

# Optional explicit environment label for client payloads
# VITE_ENV=development

# Frontend observability endpoints
# In production these default to /api/telemetry/runtime and /api/telemetry/web-vitals.
# Set these only if you want to use an external ingestion endpoint.
# VITE_RUNTIME_MONITORING_ENDPOINT=https://logs.example.com/frontend/runtime
# VITE_RUM_METRICS_ENDPOINT=https://logs.example.com/frontend/web-vitals

# Build version tag used by monitoring payloads
# VITE_APP_VERSION=2026.03.04+sha1234

# Server-side telemetry forwarding (Vercel project env vars)
# RUNTIME_MONITOR_FORWARD_ENDPOINT=https://logs.example.com/ingest/runtime
# RUM_METRICS_FORWARD_ENDPOINT=https://logs.example.com/ingest/web-vitals

# Optional fallback forwarder used by both telemetry handlers
# TELEMETRY_FORWARD_ENDPOINT=https://logs.example.com/ingest/all

# Optional alert webhook (Slack or generic JSON webhook)
# MONITORING_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/XXXX/XXXX

# Optional dedupe window for server-side alerts (milliseconds)
# MONITORING_ALERT_WINDOW_MS=300000
